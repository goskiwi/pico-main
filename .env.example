# Local Qdrant started with `docker compose up -d qdrant`.
PICO_QDRANT_URL=http://localhost:6333
# Keep empty for the bundled local-only Qdrant service.  Set this for a
# protected self-hosted instance or Qdrant Cloud.
PICO_QDRANT_API_KEY=
PICO_QDRANT_COLLECTION=pico_memory

# DashScope's OpenAI-compatible embeddings endpoint.  Use the value of
# DASHSCOPE_API_KEY from the Glodex environment; do not commit .env.local.
PICO_EMBEDDINGS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PICO_EMBEDDINGS_API_KEY=
PICO_EMBEDDINGS_MODEL=text-embedding-v4
PICO_EMBEDDINGS_DIMENSION=1024
